{
  "name": "staygreen",
  "version": "1.0.4",
  "description": "Keep your Teams status green: a tiny tray app that stops Teams, Slack & co. from marking you Away",
  "main": "main.js",
  "author": "TheGeekyM",
  "license": "MIT",
  "repository": "github:TheGeekyM/staygreen",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.thegeekym.staygreen",
    "productName": "StayGreen",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icon.png",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png",
      "category": "Utility"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
